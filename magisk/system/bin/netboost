#!/system/bin/sh
# netboost - control reversible Jio 5G network tuning.
set -eu

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
MODDIR=
for candidate in /data/adb/modules/netboost /data/adb/modules_update/netboost; do
  if [ -d "$candidate/tools" ]; then
    MODDIR=$candidate
    break
  fi
done
if [ -z "$MODDIR" ]; then
  # Repository layout: magisk/system/bin/netboost -> magisk/
  MODDIR=$(cd "$SELF_DIR/../.." && pwd)
fi
# shellcheck source=../../tools/common.sh
. "$MODDIR/tools/common.sh"
TOOLS=$MODDIR/tools

usage() {
  cat <<'EOF'
netboost - reversible Jio 5G tuning for rooted Qualcomm devices

Usage:
  netboost status                profile, bands, signal, TCP, hotspot
  netboost profile <name>        apply and persist a band profile
  netboost bench [seconds]       sustained download + loaded latency
  netboost reelmode on|off|status  Data Saver + media whitelist
  netboost wifi-tune on|off|status  disable Wi-Fi scan-always + power-save
  netboost tune on|off           upload-side TCP tuning
  netboost wifi on|off|status    Wi-Fi client only (hotspot is separate)
  netboost hotspot               show the SoftAP band and state
  netboost version               print the version
  netboost help                  this text

Profiles:
  reset     hardware defaults (all bands, SA/NSA)
  n78n28    NR-SA n28+n78, SA only (recommended)
  n78       NR-SA n78 only, SA only (lower latency)
  saonly    all NR-SA bands, SA only
  srm       NR-SA n28 only, SA only (SRM KTR / indoor coverage)
  srm-lte   LTE B3/B5/B28/B40 only (weak-signal fallback)
  lte       LTE B3/B5/B40 only (fallback testing)

Band changes are temporary and never touch modem NV. "profile reset"
or a reboot restores the hardware defaults.
EOF
}

signal_state() {
  dumpsys telephony.registry 2>/dev/null \
    | grep -m1 'mSignalStrength=' \
    | tr ',' '\n' \
    | grep -E 'ssRsrp|ssRsrq|ssSinr' || true
}

radio_state() {
  dumpsys telephony.registry 2>/dev/null \
    | grep -m1 'mServiceState=' \
    | tr ',' '\n' \
    | grep -E 'mOperatorAlphaLong|getRilDataRadioTechnology|mDataRegState' \
    | head -n 3 || true
}

hotspot_state() {
  if command -v dumpsys >/dev/null 2>&1; then
    dumpsys wifi 2>/dev/null \
      | grep -m1 'mCurrentSoftApInfoMap' \
      || printf 'hotspot state unavailable\n'
  fi
}

cmd_status() {
  printf 'netboost %s\n' "$NB_VERSION"
  printf 'profile : %s\n' "$(nb_read_profile)"

  printf '\n%s\n' '--- bands ---'
  sh "$TOOLS/bandctl.sh" show || true

  printf '\n%s\n' '--- signal ---'
  SIG=$(signal_state)
  printf '%s\n' "$SIG"
  RSRP=$(printf '%s\n' "$SIG" | sed -n 's/.*ssRsrp = \([-0-9]*\).*/\1/p' | head -n 1)
  SINR=$(printf '%s\n' "$SIG" | sed -n 's/.*ssSinr = \([-0-9]*\).*/\1/p' | head -n 1)
  if [ -n "$RSRP" ] && [ "$RSRP" != "2147483647" ] && [ "$RSRP" -lt -110 ]; then
    printf '\nhint: weak n78 (%s dBm); try: netboost profile srm\n' "$RSRP"
  elif [ -n "$SINR" ] && [ "$SINR" != "2147483647" ] && [ "$SINR" -lt 5 ]; then
    printf '\nhint: low SINR (%s dB); try: netboost profile srm\n' "$SINR"
  fi

  printf '\n%s\n' '--- radio ---'
  radio_state

  printf '\n%s\n' '--- tcp ---'
  sysctl net.ipv4.tcp_limit_output_bytes net.ipv4.tcp_notsent_lowat \
    net.ipv4.tcp_rmem net.ipv4.tcp_wmem 2>/dev/null || true

  printf '\n%s\n' '--- settings ---'
  printf 'mobile_data_always_on=%s\n' \
    "$(settings get global mobile_data_always_on 2>/dev/null || printf '?')"

  printf '\n%s\n' '--- hotspot ---'
  hotspot_state
}

cmd_profile() {
  if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
  fi

  sh "$TOOLS/bandctl.sh" "$1"

  if [ "$1" = "reset" ]; then
    nb_write_profile none
  else
    nb_write_profile "$1"
  fi
  printf 'saved profile: %s\n' "$(nb_read_profile)"
}

cmd_tune() {
  case "${1:-}" in
    on)
      nb_require_root
      sysctl -w net.ipv4.tcp_limit_output_bytes=2097152
      sysctl -w net.ipv4.tcp_notsent_lowat=262144
      printf 'tcp tuning enabled\n'
      ;;
    off)
      nb_require_root
      sysctl -w net.ipv4.tcp_limit_output_bytes=506072
      sysctl -w net.ipv4.tcp_notsent_lowat=16384
      printf 'tcp tuning restored to stock\n'
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

netpolicy_whitelist() {
  cmd netpolicy list restrict-background-whitelist 2>/dev/null \
    | sed 's/.*UIDs: //' | tr ' ' '\n' | grep -E '^[0-9]+$' || true
}

uid_for_package() {
  cmd package list packages -U 2>/dev/null \
    | awk -v p="$1" '$1 == "package:" p { sub("uid:", "", $2); print $2; exit }'
}

cmd_reelmode() {
  case "${1:-}" in
    on)
      nb_require_root
      nb_ensure_dir "$NB_HOME"
      netpolicy_whitelist > "$NB_HOME/reelmode.prev-whitelist"
      cmd netpolicy get restrict-background \
        > "$NB_HOME/reelmode.prev-state" 2>/dev/null || true
      cmd netpolicy set restrict-background true
      : > "$NB_HOME/reelmode.added"
      for pkg in \
        com.instagram.android \
        com.google.android.youtube \
        com.whatsapp \
        com.telegram.messenger \
        com.android.chrome \
        com.spotify.music; do
        uid=$(uid_for_package "$pkg")
        [ -n "$uid" ] || continue
        if ! grep -qx "$uid" "$NB_HOME/reelmode.prev-whitelist"; then
          cmd netpolicy add restrict-background-whitelist "$uid" \
            >/dev/null 2>&1 || true
          printf '%s\n' "$uid" >> "$NB_HOME/reelmode.added"
        fi
      done
      printf 'reel mode on (background data restricted, media apps whitelisted)\n'
      printf 'whitelisted UIDs: %s\n' "$(tr '\n' ' ' < "$NB_HOME/reelmode.added")"
      ;;
    off)
      nb_require_root
      if [ -f "$NB_HOME/reelmode.prev-state" ] \
        && grep -q 'enabled' "$NB_HOME/reelmode.prev-state"; then
        cmd netpolicy set restrict-background true
      else
        cmd netpolicy set restrict-background false
      fi
      if [ -f "$NB_HOME/reelmode.added" ]; then
        while IFS= read -r uid; do
          [ -n "$uid" ] || continue
          if [ -f "$NB_HOME/reelmode.prev-whitelist" ] \
            && grep -qx "$uid" "$NB_HOME/reelmode.prev-whitelist"; then
            continue
          fi
          cmd netpolicy remove restrict-background-whitelist "$uid" \
            >/dev/null 2>&1 || true
        done < "$NB_HOME/reelmode.added"
      fi
      rm -f "$NB_HOME/reelmode.added"
      printf 'reel mode off; previous background policy restored\n'
      ;;
    status)
      cmd netpolicy get restrict-background 2>/dev/null || true
      printf 'whitelisted UIDs: %s\n' "$(netpolicy_whitelist | tr '\n' ' ')"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

cmd_wifi() {
  case "${1:-status}" in
    on)
      svc wifi enable
      printf 'wifi client enabled\n'
      ;;
    off)
      svc wifi disable
      printf 'wifi client disabled (hotspot is unaffected)\n'
      ;;
    status)
      cmd wifi status 2>/dev/null | head -n 6 || true
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

cmd_wifi_tune() {
  case "${1:-}" in
    on)
      nb_require_root
      settings put global wifi_scan_always_enabled 0
      cmd wifi set-scan-always-available disabled >/dev/null 2>&1 || true
      settings put global wifi_power_save 0
      printf 'wifi tuning on (scan-always off, power-save off)\n'
      ;;
    off)
      nb_require_root
      settings put global wifi_scan_always_enabled 1
      cmd wifi set-scan-always-available enabled >/dev/null 2>&1 || true
      settings put global wifi_power_save 120
      printf 'wifi tuning off (stock values restored)\n'
      ;;
    status)
      printf 'wifi_scan_always_enabled=%s\n' \
        "$(settings get global wifi_scan_always_enabled 2>/dev/null || printf '?')"
      printf 'wifi_power_save=%s\n' \
        "$(settings get global wifi_power_save 2>/dev/null || printf '?')"
      cmd wifi status 2>/dev/null | grep -m1 'WifiInfo' || true
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main() {
  if [ "$#" -lt 1 ]; then
    usage
    exit 0
  fi

  COMMAND=$1
  shift

  case "$COMMAND" in
    help|-h|--help)
      usage
      ;;
    version|-V|--version)
      printf 'netboost %s\n' "$NB_VERSION"
      ;;
    status)
      cmd_status
      ;;
    profile)
      cmd_profile "$@"
      ;;
    bench)
      sh "$TOOLS/bench.sh" "${1:-5}"
      ;;
    tune)
      cmd_tune "${1:-}"
      ;;
    reelmode)
      cmd_reelmode "${1:-}"
      ;;
    wifi)
      cmd_wifi "${1:-status}"
      ;;
    wifi-tune)
      cmd_wifi_tune "${1:-}"
      ;;
    hotspot)
      hotspot_state
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
